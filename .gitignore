# Ảnh chụp màn hình và hồ sơ Chrome tạm — không đưa vào repo
_shots/

# Tệp tạm khi kiểm tra giao diện
_probe.html
_probe*.html
_dump.html

# HTML do `_tools/render_pages.py` sinh ra — dựng lại được bất cứ lúc nào
demo/_render/

# Dữ liệu chạy thật: CSDL SQLite và thư mục làm việc của bộ chấm.
#
# Tuyệt đối không đưa thư mục này vào repo. CSDL chứa hàm băm mật khẩu của toàn
# bộ tài khoản học sinh, và repo này là công khai. Băm bằng PBKDF2 chỉ làm việc
# thử mật khẩu trở nên đắt, không làm nó bất khả thi — nhất là khi mật khẩu do
# giáo viên đặt theo một quy tắc dễ đoán.
server/var/

# Mã đã biên dịch
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Hệ điều hành
.DS_Store
Thumbs.db
desktop.ini

# Trình soạn thảo
.vscode/
.idea/
*.swp

# Biến môi trường khi chạy thật — chứa SONGLO_SECRET và SONGLO_AI_KEY.
#
# Khoá API viết thẳng vào mã nguồn là khoá đã bị lộ, và xoá nó ở commit sau không
# thu hồi được: nó vẫn nằm trong lịch sử git. Repo này là công khai.
.env
.env.*
